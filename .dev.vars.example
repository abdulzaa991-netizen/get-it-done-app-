# Copy to .dev.vars for local development. .dev.vars is git-ignored; never commit real keys.
# Leave the Stripe keys empty to run in "simulated payments" mode (no money moves).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADMIN_EMAILS=you@example.com
# Leave empty to log emails instead of sending them. DEV_OUTBOX=true captures them locally for testing.
RESEND_API_KEY=
DEV_OUTBOX=true
